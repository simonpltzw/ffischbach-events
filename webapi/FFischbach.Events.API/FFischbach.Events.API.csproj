<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-FFischbach.Events.API-5cb54ae9-7fc6-41f1-9bd0-bccf2e7b3ea3</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>.</DockerfileContext>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="signup-form.html" />
	</ItemGroup>

	<ItemGroup>
        <PackageReference Include="MailKit" Version="5.0.0" />
        <PackageReference Include="Mapster" Version="10.0.14" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" NoWarn="NU1605" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
		<PackageReference Include="Microsoft.Identity.Web" Version="4.18.0" />
		<PackageReference Include="Microsoft.Identity.Web.DownstreamApi" Version="4.18.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Seq" Version="9.2.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
        <PackageReference Include="Swashbuckle.AspNetCore.Newtonsoft" Version="10.3.1" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="signup-form.html">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>

</Project>
