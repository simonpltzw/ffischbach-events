<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FFischbach.Events.API\FFischbach.Events.API.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
	  <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
	  <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	    <PrivateAssets>all</PrivateAssets>
	  </PackageReference>
	  <PackageReference Include="xunit.v3" Version="4.0.3" />
	</ItemGroup>

</Project>
